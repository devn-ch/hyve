#cloud-config

# if you want to start debian manually with a passwordless root account, uncomment the following lines
# note: this is not recommended for production testing use, but it is useful for development
# users:
#   - name: debian
#     groups: [sudo]
#     sudo: ALL=(ALL) NOPASSWD:ALL
#     lock_passwd: false
#     plain_text_passwd: hyve-test
#     shell: /bin/bash
  
package_update: true

packages:
  - qemu-guest-agent

runcmd:
  - systemctl enable qemu-guest-agent.service
  - systemctl start qemu-guest-agent.service
  - systemctl is-active qemu-guest-agent.service

power_state:
  mode: poweroff
  timeout: 30
  condition: true